# Copiez ce fichier en `.env` sur votre poste de travail.
# `.env` est ignoré par git et ne doit jamais être remis avec le projet.
#
# Sans DATABASE_URL, le projet utilise les variables libpq standard
# (PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD) puis une URL par défaut
# sans mot de passe : postgresql://campusequip@127.0.0.1:5432/campusequip

DATABASE_URL=postgresql://campusequip@127.0.0.1:5432/campusequip

# Base de test (le nom doit finir par _test)
CAMPUSEQUIP_TEST_URL=postgresql://postgres@127.0.0.1:5432/campusequip_test

# Dossiers de sortie facultatifs (valeurs par défaut entre parenthèses)
# CAMPUSEQUIP_RAPPORTS=./rapports
# CAMPUSEQUIP_QUARANTAINE=./quarantaine

# Axes 3–4 (utilisés par les commandes locales hors Docker)
# MONGODB_URL=mongodb://127.0.0.1:27018
# MONGODB_DATABASE=campusequip
# REDIS_URL=redis://127.0.0.1:6380/0
# TIMESCALE_URL=postgresql://campusequip:campusequip@127.0.0.1:5435/campusequip_ts
# MONGODB_HOST_PORT=27018
# REDIS_HOST_PORT=6380
# TIMESCALE_HOST_PORT=5435
